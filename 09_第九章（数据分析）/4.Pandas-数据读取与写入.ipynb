    "import pandas as pd\n",
    "\n",
    "#读取数据 --> read_csv\n",
    "\n",
    "df = pd.read_csv('data/sales.csv',usecols=['订单号','产品类别','销售数量','单价'])\n",
    "# df\n",
    "\n",
    "#数据处理\n",
    "\n",
    "df['销售金额'] = df['销售数量'] * df['单价']\n",
    "#df\n",
    "\n",
    "#写入数据 --> to_csv\n",
    "\n",
    "df.to_csv('data/sales_01.csv',index=False)"
