#%%
# ==================== TMDB Top300 电影榜单数据统计（单单元格完整版） ====================
import pandas as pd
import matplotlib.pyplot as plt

# 配置中文显示，使用黑体（SimHei），并解决负号显示问题
plt.rcParams['font.sans-serif'] = ['SimHei']
plt.rcParams['axes.unicode_minus'] = False

# 创建 2×2 子图画布
fig, axes = plt.subplots(nrows=2, ncols=2, figsize=(14, 10), dpi=100)

# 获取 4 个子图对象
ax1, ax2 = axes[0]      # 第一行的左、右两个子图
ax3, ax4 = axes[1]      # 第二行的左、右两个子图

# 加载 movies.csv 数据（TMDB Top300 高分电影榜单）
movies = pd.read_csv("data/movies.csv")

# ---------- 处理"年份"列缺失值：用"上映时间"前 4 个字符补充 ----------
year_from_date = pd.to_numeric(
    movies["上映时间"].astype(str).str[:4],
    errors="coerce"
)
movies["年份"] = movies["年份"].fillna(year_from_date)

# 检查异常年份（小于 0 或大于 3000），正常则无需处理
print("异常年份记录数:", len(movies[(movies["年份"] < 0) | (movies["年份"] > 3000)]))

# 统一转为整数年份，方便分组统计与作图
movies["年份"] = movies["年份"].astype(int)
print("填充后年份缺失数量:", movies["年份"].isnull().sum())

# ==================== 子图 1：每一年上映电影数量变化 —— 折线图 ====================
# 按"年份"分组，统计每年上榜的电影数量
year_counts = movies.groupby("年份")["电影名"].count()

# 组装 X 轴：最小年份到最大年份的连续年份，避免折线断续
min_year = year_counts.index.min()
max_year = year_counts.index.max()
x_years = list(range(min_year, max_year + 1))

# 组装 Y 轴：某年没有电影上榜则补 0，保证与 X 轴一一对应
y_counts = [year_counts.get(year, 0) for year in x_years]

# 绘制并美化折线图
ax1.plot(x_years, y_counts, color="green")
ax1.set_title("每一年上映电影数量变化", fontsize=14)
ax1.set_xlabel("年份", fontsize=12)
ax1.set_ylabel("电影数量", fontsize=12)
ax1.set_xticks(range(min_year, max_year + 1, 8))   # 每隔 8 年显示一个刻度，避免拥挤
ax1.set_ylim(0, 30)
ax1.set_yticks(range(0, 31, 5))
ax1.grid(True, linestyle="--", alpha=0.5)

# ==================== 子图 2：不同语言电影数量统计 —— 柱状图 ====================
# 按"语言"分组统计数量，并按数量降序排列，方便对比
lang_counts = movies.groupby("语言")["电影名"].count().sort_values(ascending=False)

ax2.bar(lang_counts.index, lang_counts.values, color="skyblue", width=0.6)
ax2.bar_label(ax2.containers[0])                    # 在柱顶标注具体数量
ax2.set_title("不同语言电影数量统计", fontsize=14)
ax2.set_xlabel("语言", fontsize=12)
ax2.set_ylabel("电影数量", fontsize=12)
ax2.grid(True, axis="y", linestyle="--", alpha=0.5) # 只加横向网格，避免遮挡柱子

# ==================== 子图 3：不同类型电影数量统计 —— 柱状图 ====================
# 特别处理：一部电影可能有多个类型（如"剧情,犯罪"）
# 先按逗号拆分，再 explode 展开成一行一个类型，同一部电影就会分别计入多个类型
genre_series = movies["类型"].str.split(",").explode().str.strip()
genre_counts = genre_series.value_counts()          # 统计每个类型的电影数量（降序）

ax3.bar(genre_counts.index, genre_counts.values, color="orange", width=0.6)
ax3.bar_label(ax3.containers[0])
ax3.set_title("不同类型电影数量统计", fontsize=14)
ax3.set_xlabel("类型", fontsize=12)
ax3.set_ylabel("电影数量", fontsize=12)
ax3.tick_params(axis="x", rotation=45)              # 类型较多，X 轴刻度倾斜避免重叠
ax3.grid(True, axis="y", linestyle="--", alpha=0.5)

# ==================== 子图 4：不同电影评分占比统计 —— 饼状图 ====================
# 评分列存储的是 87、86 这样的整数，对应 8.7、8.6，展示时除以 10 还原
rating_counts = movies.groupby("评分")["电影名"].count()
rating_labels: list[str] = []
for score in rating_counts.index:
    # int() 先把类型收窄为 int，除以 10 后结果必然是 float，可安全使用 :.1f 格式规范
    display_score: float = int(score) / 10
    rating_labels.append(f"{display_score:.1f}")   # 饼图类别标签：8.0、8.1……

ax4.pie(
    rating_counts.values,
    labels=rating_labels,
    autopct="%1.1f%%",           # 显示百分比，%% 是转义后的百分号
    startangle=90,               # 从正上方开始分布，更美观
)
ax4.set_title("不同电影评分占比统计", fontsize=14)

# ==================== 最终整体美化并展示报表 ====================
# 给整份报表加总标题（y 留出空间，避免与子图标题重叠）
fig.suptitle("TMDB Top300 电影榜单数据统计", fontsize=20, fontweight="bold", y=0.98)

# 自动调整子图间距，rect 给总标题预留位置
plt.tight_layout(rect=(0, 0, 1, 0.94))

plt.show()